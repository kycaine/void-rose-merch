# Payment Mode: simulated | midtrans
PAYMENT_MODE=simulated
ENVIRONMENT=development

# Midtrans Configuration (Mode: midtrans)
# Dapatkan Server Key & Client Key dari Midtrans Dashboard -> Settings -> Access Keys (Sandbox / Production)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Resend Email Configuration
# Dapatkan API Key dari https://resend.com/api-keys
# Jika kosong, sistem otomatis masuk ke Dev Mode (email dicatat di console dan tabel email_logs)
RESEND_API_KEY=
RESEND_FROM="VOID/ROSE Merch <merch@voidrose.com>"

# App URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# Admin Secret Key (header: X-Admin-Token)
ADMIN_SECRET_KEY=void-rose-super-secret-admin-key-2026
