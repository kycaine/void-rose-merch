# Public Web App Environment Variables
# Copy to .env.local for local development or set in Cloudflare Pages dashboard for production

# API Base URL (empty for same-origin proxy in development)
VITE_API_URL=/api

# Midtrans Client Key (Snap.js frontend integration)
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here

# Midtrans Production Mode (true for production, false for sandbox)
VITE_MIDTRANS_IS_PRODUCTION=false
